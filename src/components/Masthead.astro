---
import dragon from '../assets/dragon.svg?raw';
import LangSwitcher from './LangSwitcher.astro';
import { t } from '../i18n/ui';
import { url } from '../lib/url';

export type Tab = 'raison' | 'projects' | 'about';

interface Props {
  active: Tab;
}
const { active } = Astro.props;

const tabs: { id: Tab; href: string; label: string }[] = [
  { id: 'raison', href: '/', label: t('nav.raison') },
  { id: 'projects', href: '/projetos', label: t('nav.projects') },
  { id: 'about', href: '/sobre', label: t('nav.about') },
];
---

<header class="masthead">
  <LangSwitcher />
  <div class="container inner">
    <a class="logo" href={url('/')} aria-label={t('site.title')}>
      <Fragment set:html={dragon} />
    </a>
    <h1 class="title">{t('site.title')}</h1>
    <p class="subtitle smallcaps">
      {t('site.subtitle').split(' · ').map((part, i) => <>{i > 0 && <span class="sep"> · </span>}<span class="part">{part}</span></>)}
    </p>
    <nav class="tabs" aria-label="Seções">
      {
        tabs.map((tab) => (
          <a href={url(tab.href)} aria-current={tab.id === active ? 'page' : undefined}>
            {tab.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    padding: 64px 0 0;
    view-transition-name: masthead;
  }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .logo { color: var(--red); display: block; width: 76px; height: 76px; margin-bottom: 18px; }
  .logo :global(svg) { width: 100%; height: 100%; }
  .title {
    font-size: clamp(2.1rem, 6vw, 3.9rem);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.08;
    margin: 0 0 12px;
  }
  .subtitle { color: var(--green); margin: 0 0 36px; font-size: 1.02rem; }
  .subtitle .part { white-space: nowrap; }

  /* Tabs sit on a double rule, like a LaTeX title block. */
  .tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 40px;
    /* the rule spans only the tab titles, not the whole page */
    padding: 10px 0 0;
    border-bottom: 3px double var(--text);
  }
  .tabs a {
    position: relative;
    padding: 6px 2px 12px;
    color: var(--muted);
    text-decoration: none;
    font-size: 1.12rem;
  }
  .tabs a:hover { color: var(--text); }
  .tabs a[aria-current='page'] { color: var(--text); }
  .tabs a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 3px;
    background: var(--red);
    /* the underline slides between tabs during the page transition */
    view-transition-name: tab-underline;
  }
  @media (max-width: 560px) {
    .masthead { padding-top: 44px; }
    .logo { width: 52px; height: 52px; margin-bottom: 12px; }
    .subtitle { margin-bottom: 24px; font-size: 0.95rem; }
    .subtitle .sep { display: none; }
    .subtitle .part { display: block; }
    .tabs { gap: 4px 22px; }
    .tabs a { font-size: 1rem; }
  }
</style>
