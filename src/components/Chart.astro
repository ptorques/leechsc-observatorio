---
/**
 * A numbered, LaTeX-style figure holding one interactive chart.
 *
 *   <Chart name="partner-share" data={partnerShare} caption="…" />
 *
 * `name` picks a builder from src/charts/index.ts. Optional controls go in the
 * "controls" slot as <select data-control="x"> or
 * <button data-control="x" data-value="…" aria-pressed="true|false">.
 */
interface Props {
  name: string;
  data: unknown;
  caption: string;
  height?: number;
  /** marks the figure as using provisional random data */
  placeholder?: boolean;
  /** data source, shown after the caption ("Fonte: …") */
  source?: string;
}
const { name, data, caption, height = 420, placeholder = true, source } = Astro.props;
---

<figure class="figure" data-chart-root>
  {Astro.slots.has('controls') && <div class="controls"><slot name="controls" /></div>}
  <div
    class="chart"
    data-chart={name}
    data-payload={JSON.stringify(data)}
    style={`height:${height}px`}
    role="img"
    aria-label={caption}
  >
  </div>
  <figcaption>
    <span class="label">Figura <span class="num"></span>.</span>
    {caption}
    {placeholder && <span class="ph">(dados ilustrativos)</span>}
    {source && <span class="src">Fonte: {source}</span>}
  </figcaption>
</figure>

<script>
  import '../scripts/charts';
</script>

<style>
  .figure {
    counter-increment: figure;
    margin: 2em 0 2.4em;
  }
  .controls {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
    flex-wrap: wrap;
    margin-bottom: 8px;
    font-size: 0.92rem;
  }
  .chart { width: 100%; }
  @media (max-width: 640px) {
    .chart { height: 340px !important; }
  }
  /* the chart spans the page; the caption keeps the text column */
  figcaption {
    max-width: var(--measure);
    margin: 12px auto 0;
    font-size: 0.95rem;
    text-align: justify;
    hyphens: auto;
    line-height: 1.45;
  }
  .label { font-weight: 700; margin-right: 0.35em; }
  .ph { margin-left: 0.3em; }
  .num::before { content: counter(figure); }
  .ph { color: var(--muted); font-style: italic; }
  .src { display: block; margin-top: 4px; font-size: 0.85rem; color: var(--muted); }
</style>
