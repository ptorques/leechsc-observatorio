---
import { t } from '../i18n/ui';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="smallcaps">{t('site.title')}</p>
    <p class="muted">
      {[...t('site.subtitle').split(' · '), String(year)].map((part, i) => <>{i > 0 && ' · '}<span class="part">{part}</span></>)}
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: 96px; padding: 28px 0 40px; border-top: 3px double var(--text); }
  .inner { text-align: center; font-size: 0.92rem; }
  p { margin: 0 0 4px; }
  .muted { color: var(--muted); }
  .part { white-space: nowrap; }
</style>
